	measure 'Critical Errors' =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS(master_pipeline_monitoring),
			        FILTER(
			            master_pipeline_monitoring,
			            LOWER(master_pipeline_monitoring[status]) IN { "fail", "failed" }
			&& NOT ISBLANK(master_pipeline_monitoring[error_message])
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: b539dd63-4c18-49f4-abd9-a3e41615cd39

	measure 'DQ Score %' = ```
			
			VAR TotalWritten =
			    SUM(pipeline_monitoring[rows_written])
			 
			VAR TotalRejected =
			    SUM(pipeline_monitoring[rows_rejected])
			 
			RETURN
			IF(
			    TotalWritten = 0,
			    BLANK(),
			    DIVIDE(TotalWritten - TotalRejected, TotalWritten)
			)
			```
		lineageTag: ce7aa2b7-d3e0-4085-968c-250dd71d5d86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

