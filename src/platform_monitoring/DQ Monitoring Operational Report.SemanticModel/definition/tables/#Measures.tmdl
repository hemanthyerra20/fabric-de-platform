	measure 'Last Run' =
			
			VAR LastRunDate=CALCULATE(MAX(master_pipeline_monitoring[end_time])
			)
			RETURN
			IF(ISBLANK(LastRunDate),
			BLANK(),
			FORMAT(LastRunDate,"dd-MMM-yyyy"))
		lineageTag: 088b7f23-95c3-4a3d-a318-1cde67cd4455

	measure 'Long Running Runs' =
