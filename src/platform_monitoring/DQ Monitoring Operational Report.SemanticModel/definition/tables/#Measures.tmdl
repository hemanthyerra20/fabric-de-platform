	measure 'Workday CS' = ```
			
			VAR LatestStartTime =
			    CALCULATE (
			        MAX ( master_pipeline_monitoring[start_time] ),
			        FILTER (
			            ALL ( master_pipeline_monitoring ),
			            LOWER (
			                TRIM (
			                    master_pipeline_monitoring[source_name]
			                )
			            ) = "Workday"
			        )
			    )
			
			VAR LatestEndTime =
			    CALCULATE (
			        MAX ( master_pipeline_monitoring[end_time] ),
			        FILTER (
			            ALL ( master_pipeline_monitoring ),
			            LOWER (
			                TRIM (
			                    master_pipeline_monitoring[source_name]
			                )
			            ) = "Workday"
			                && master_pipeline_monitoring[start_time]
			                    = LatestStartTime
			        )
			    )
			
			VAR LatestStatus =
			    CALCULATE (
			        SELECTEDVALUE (
			            master_pipeline_monitoring[status]
			        ),
			        FILTER (
			            ALL ( master_pipeline_monitoring ),
			            LOWER (
			                TRIM (
			                    master_pipeline_monitoring[source_name]
			                )
			            ) = "Workday"
			                && master_pipeline_monitoring[start_time]
			                    = LatestStartTime
			        )
			    )
			
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LatestStartTime ), "No Run",
			        ISBLANK ( LatestEndTime ), "inprogress",
			        LOWER ( TRIM ( LatestStatus ) ) = "successsuccess",
			            "Success",
			        LOWER ( TRIM ( LatestStatus ) ) = "fail",
			            "Failed",
			        "No Run"
			    )
			 
			```
		lineageTag: 5fa8e1c4-4dc8-4c7d-8088-80efe0c8f64f

