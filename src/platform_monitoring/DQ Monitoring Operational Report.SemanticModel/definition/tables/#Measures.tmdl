	measure 'Success %' =
			
			VAR TotalRun =[Total Runs]
			VAR SuccessRun =[Success Runs]
			RETURN
			IF([Total Runs]=0,
			BLANK(),
			DIVIDE(SuccessRun,TotalRun)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 804a6f04-be80-42eb-9237-3f150f407ab0

