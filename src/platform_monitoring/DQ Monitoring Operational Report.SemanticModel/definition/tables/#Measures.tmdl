table #Measures
	lineageTag: 5a281cb6-7e41-43e1-9d28-c5a054361f4b

	measure 'Alert Status' =
			SWITCH(TRUE(),
			[Failure Runs]>0,"Critical",
			[Long Running Runs]>0,"Warning","Healthy")
		lineageTag: ab833d59-5a27-41e3-a151-0dbc82a5f751

	measure 'Avg Duration Min' = DIVIDE(AVERAGE(master_pipeline_monitoring[duration_seconds]),60,0)
		lineageTag: 9f02955c-9928-44a0-b1a4-f7bf60cf7c35

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Canvas = ```
			
			VAR LatestRun =
			    TOPN(
			        1,
			        FILTER(
			            ALL(master_pipeline_monitoring),
			            LOWER(master_pipeline_monitoring[source_name]) = "Canvas"
			        ),
			        COALESCE(
			            master_pipeline_monitoring[end_time],
			            master_pipeline_monitoring[start_time]
			        ),
			        DESC
			    )
			 
			VAR LatestEndTime =
			    MAXX(LatestRun, master_pipeline_monitoring[end_time])
			 
			VAR LatestStartTime =
			    MAXX(LatestRun, master_pipeline_monitoring[start_time])
			 
			VAR LatestStatus =
			    MAXX(LatestRun, master_pipeline_monitoring[status])
			 
			RETURN
			SWITCH(
			    TRUE(),
			 
			    NOT(ISBLANK(LatestEndTime)) &&
			    LOWER(LatestStatus) = "success",
			        "Success",
			 
			    NOT(ISBLANK(LatestEndTime)) &&
			    LOWER(LatestStatus) = "fail",
			        "Failed",
			 
			    ISBLANK(LatestEndTime) &&
			    NOT(ISBLANK(LatestStartTime)),
			        "In Progress",
			 
			    "No Run"
			)
			```
		lineageTag: 356f345d-1bbe-4dc4-9ff2-204b8a6097af

	measure 'Canvas Color' =
			
			SWITCH(
			    [Canvas],
			    "Success", "#28A745",
			    "Failed", "#DC3545",
			    "In Progress", "#003865",
			    "No Run", "#808080"
			)
		lineageTag: d0138055-6f33-4c5f-96f2-10e1636c4638

	measure 'Canvas Last Refresh Time' =
			
			VAR LastEndTime =
			    CALCULATE(
			        MAX(master_pipeline_monitoring[end_time]),
			        FILTER(
			            ALL(master_pipeline_monitoring),
			            LOWER(master_pipeline_monitoring[source_name]) = "Canvas"
			        )
			    )
			RETURN
			IF(
			    ISBLANK(LastEndTime),
			    "Last Refresh: No completed run",
			    "Last Refresh: " &
			    FORMAT(LastEndTime, "dd-MMM-yyyy hh:mm AM/PM")
			)
		lineageTag: 0b59598b-aaa5-4935-936e-3983cf716133

