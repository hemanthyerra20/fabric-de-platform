	partition Calendar = calculated
		mode: import
		source = ```
				
				VAR AllDates =
				    UNION(
				        SELECTCOLUMNS(
				            master_pipeline_monitoring,
				            "RunDate", master_pipeline_monitoring[Master Start Date]
				        ),
				        SELECTCOLUMNS(
				            master_pipeline_monitoring,
				            "RunDate", master_pipeline_monitoring[Master End Date]
				        ),
				        SELECTCOLUMNS(
				            pipeline_monitoring,
				            "RunDate", pipeline_monitoring[Pipeline Start Date]
				        ),
				        SELECTCOLUMNS(
				            pipeline_monitoring,
				            "RunDate", pipeline_monitoring[Pipeline End Date]
				        )
				    )
				 
				VAR MinimumDate =
				    MINX(
				        FILTER(AllDates, NOT ISBLANK([RunDate])),
				        [RunDate]
				    )
				 
				VAR MaximumDate =
				    MAXX(
				        FILTER(AllDates, NOT ISBLANK([RunDate])),
				        [RunDate]
				    )
				 
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinimumDate, MaximumDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Month Year", FORMAT([Date], "MMM yyyy"),
				    "Month Year Sort", YEAR([Date]) * 100 + MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day", DAY([Date]),
				    "Day Name", FORMAT([Date], "ddd"),
				    "Weekday Number", WEEKDAY([Date], 2)
				)
				```

	annotation PBI_Id = 5863e7b9cf834ad69a56014fffba14d0

