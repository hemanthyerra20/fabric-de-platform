table pipeline_monitoring
	lineageTag: 26b8bd14-178f-4006-ac2a-9eba639fb00e
	sourceLineageTag: 4f944fff-f699-45ea-8eb6-e3ff0efa2f11

	measure 'Total Runs' = COUNTROWS(pipeline_monitoring)+0
		formatString: 0
		lineageTag: 82df955e-3e14-4376-9f94-00345175217e

	measure 'Success Runs' = COALESCE(CALCULATE([Total Runs],pipeline_monitoring[status] IN{"SUCCESS","success"}),0)
		formatString: 0
		lineageTag: f1535401-7ed5-4492-a743-11ccc0944ffb

	measure 'Failed Runs' = COALESCE(CALCULATE([Total Runs],pipeline_monitoring[status]<>"SUCCESS"),0)
		formatString: 0
		lineageTag: 3a2b8001-7bd2-498a-a4d2-d1dc54effc4b

	measure 'Suucess %' = DIVIDE([Success Runs],[Total Runs],0)
		formatString: 0%;-0%;0%
		lineageTag: f2a0841c-5386-451e-ac1c-5ed7ac2f4c7a

		changedProperty = FormatString

	measure 'Total Rows Read' = COALESCE(SUM(pipeline_monitoring[rows_read]),0)
		formatString: #,0
		lineageTag: 40449f7a-d6d3-4dea-b7d6-fa9a0af97530

		changedProperty = FormatString

	measure 'Total Rows Writtern' = COALESCE(SUM(pipeline_monitoring[rows_written]),0)
		formatString: #,0
		lineageTag: e13990f2-2799-48d5-9e25-c9615aaf3116

		changedProperty = FormatString

	measure 'Total Rejected Rows' = COALESCE(SUM(pipeline_monitoring[rows_rejected]),0)
		formatString: #,0
		lineageTag: 714f2737-f4b5-478d-b593-b98fa6feef4b

		changedProperty = FormatString

	measure 'Rejected %' = DIVIDE([Total Rejected Rows],[Total Rows Read],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 325b756d-c262-4fe1-a6a6-e488d53d2944

	measure 'Avg Duration Sec' = AVERAGE(pipeline_monitoring[duration_seconds])
		lineageTag: da077fdd-c873-4aae-96d5-d2b6bd9aafbd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Duration Time' =
			
			VAR Totalseconds= MAX(pipeline_monitoring[duration_seconds])
			VAR  Hours =INT(Totalseconds/3600)
			VAR Minutes =INT(MOD(Totalseconds,3600)/60)
			VAR Seconds =MOD(Totalseconds,60)
			RETURN
			FORMAT(Hours,"00") & ":"
			& FORMAT(Minutes,"00") & ":"
			& FORMAT(Seconds,"00")
		lineageTag: b03eac90-efa9-472f-b118-edb1b9617632

		changedProperty = FormatString

		changedProperty = Name

	measure 'Run Health' =
			SWITCH(TRUE(),
			SELECTEDVALUE(pipeline_monitoring[status])="SUCCESS","SUCCESS",
			SELECTEDVALUE(pipeline_monitoring[status])="FAILED","FAILED","OTHER")
		lineageTag: 1043ba1e-d268-4d58-a36d-42b4342e3b0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Load Efficiency %' = DIVIDE([Total Rows Writtern],[Total Rows Read],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4e54a63d-b231-4698-b79e-db5c577a8b63

	measure 'Footer Text' =
			
			"Data as of: " & FORMAT([Refresh], "dd-MMM-yyyy hh:mm AM/PM") &
			" | Source: Fabric pipeline run logs (Bronze ingestion telemetry) | Version: v1.0  "
		lineageTag: 7d15180d-be1a-48b6-ad4e-d08658bef963

	measure 'Compliance Row' = ```
			
			" WCAG 2.1 AA Compliance : " &
			"🟢 Score : 80%  "
			
			```
		lineageTag: dae6934f-18c8-425e-b14a-819969be6255

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filters Applied Count' =
			
			VAR EnvFilter =
			    IF ( ISFILTERED ( pipeline_monitoring[environment] ), 1, 0 )
			
			VAR PipelineFilter =
			    IF ( ISFILTERED ( pipeline_monitoring[pipeline_name] ), 1, 0 )
			
			VAR LayerFilter =
			    IF ( ISFILTERED ( pipeline_monitoring[layer] ), 1, 0 )
			
			VAR StatusFilter =
			    IF ( ISFILTERED ( pipeline_monitoring[status] ), 1, 0 )
			
			RETURN
			    EnvFilter + PipelineFilter + LayerFilter + StatusFilter
		lineageTag: 9129f5d9-a9fa-482d-83ee-a8612715cfdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Filters Applied List' =
			
			VAR Env =
			    IF (
			        ISFILTERED ( pipeline_monitoring[environment] ),
			        "Environment: "
			            & CONCATENATEX (
			                VALUES ( pipeline_monitoring[environment] ),
			                pipeline_monitoring[environment],
			                ", "
			            ),
			        BLANK ()
			    )
			
			VAR Pipeline =
			    IF (
			        ISFILTERED ( pipeline_monitoring[pipeline_name] ),
			        "Pipeline: "
			            & CONCATENATEX (
			                VALUES ( pipeline_monitoring[pipeline_name] ),
			                pipeline_monitoring[pipeline_name],
			                ", "
			            ),
			        BLANK ()
			    )
			
			VAR Layer =
			    IF (
			        ISFILTERED ( pipeline_monitoring[layer] ),
			        "Layer: "
			            & CONCATENATEX (
			                VALUES ( pipeline_monitoring[layer] ),
			                pipeline_monitoring[layer],
			                ", "
			            ),
			        BLANK ()
			    )
			
			VAR Statu =
			    IF (
			        ISFILTERED ( pipeline_monitoring[status] ),
			        "Status: "
			            & CONCATENATEX (
			                VALUES ( dq_run_results[status] ),
			               dq_run_results[status],
			                ", "
			            ),
			        BLANK ()
			    )
			
			RETURN
			    CONCATENATEX (
			        {
			            Env,
			            Pipeline,
			            Layer,
			            Statu
			        },
			        [Value],
			        " | "
			    )
		lineageTag: f54af324-418b-4f13-9ef0-62a78d0c4044

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Show Filters Indicator' =
			
			IF(
			    [Filters Applied Count] > 0,
			    "Filters Applied (" &
			    [Filters Applied Count] & "): " &
			    [Filters Applied List],
			    "    No Filters Applied"
			)
		lineageTag: 3101e759-bb1c-48bb-b3cf-193690cf6fd4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DQ Status' =
			SWITCH(TRUE(),
			pipeline_monitoring[Total Rejected Rows] =0,"PASS",
			pipeline_monitoring[Total Rejected Rows]<=10,"WARN","FAIL")
		lineageTag: 971435f1-40b4-4fbe-8377-f577a12221ca

		annotation PBI_FormatHint = {"isText":true}

	measure 'DQ PASS Count' =
			COALESCE(CALCULATE(COUNTROWS(pipeline_monitoring),
			pipeline_monitoring[rows_rejected]=0),0)
		lineageTag: 4f056f8a-d34f-46f7-9ffe-0e65243a6710

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
		lineageTag: ed378e76-e5ff-47fc-9ee2-74afc0863f11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DQ WARN Count' = ```
			COALESCE(CALCULATE(COUNTROWS(pipeline_monitoring),
			pipeline_monitoring[rows_rejected]>0 && 
			pipeline_monitoring[rows_rejected]<=10),0)
			```
		lineageTag: 7bdcd733-a95c-4cf1-adb7-4069821d2730

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DQ FAIL Count' =
			CALCULATE(COUNTROWS(pipeline_monitoring),
			pipeline_monitoring[rows_rejected]>10)
		lineageTag: b79b32f9-6af7-454f-b14c-260c31887a70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DQ Score %' = DIVIDE([DQ PASS Count],[Total Runs],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 19b4f5d5-3dfc-43f5-a61f-a26554b6ee45

	measure 'Critical Errors' =
			COALESCE(CALCULATE(COUNTROWS(pipeline_monitoring),
			NOT ISBLANK(pipeline_monitoring[error_message])),0)
		lineageTag: b3ad554a-2b38-4b9a-945b-67bb5ec9b91e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Long Running Runs' =
			CALCULATE(COUNTROWS(pipeline_monitoring),
			pipeline_monitoring[duration_seconds]>30)
		lineageTag: 7c31111d-002d-4668-88b4-bc9611610da6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Alert Status' =
			SWITCH(TRUE(),
			[Failed Runs]>0,"Critical",
			[Long Running Runs]>0,"Warning","Healthy")
		lineageTag: 83dbcd37-c7bd-455f-aecf-57d3f1400872

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Refresh = MAX(pipeline_monitoring[end_time])
		formatString: General Date
		lineageTag: 83cc0c98-5202-43a1-9d0c-b2da3d02274c

		changedProperty = Name

	measure 'Error type display' = IF(ISBLANK(SELECTEDVALUE(pipeline_monitoring[error_type])),"No Error",SELECTEDVALUE(pipeline_monitoring[error_type]))
		lineageTag: 9b5e1748-572b-475f-9af2-54be004801fd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Error message display' = IF(ISBLANK(SELECTEDVALUE(pipeline_monitoring[error_message])),"No Error",SELECTEDVALUE(pipeline_monitoring[error_message]))
		lineageTag: dd9e7469-7ffd-4577-aa78-3f95fc6ace31

		annotation PBI_FormatHint = {"isGeneralNumber":true}

