model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectQuery to AS - lh__platform_monitoring_semanticmodel","Source Types","Source","Executive summery","Summery table"]

ref table pipeline_monitoring
ref table dq_run_results
ref table dq_rules
ref table 'Source Types'
ref table Calendar
ref table Source
ref table 'Executive summery'
ref table 'Summery table'

ref cultureInfo en-US

